<Window x:Class="CreatorHubLive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Creator Hub Live" Height="860" Width="1180"
        MinHeight="760" MinWidth="1000"
        Background="#101217" Foreground="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="240"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="CREATOR HUB LIVE" FontSize="32" FontWeight="Bold"/>
                <TextBlock Text="OBS + Virtual Camera + echter FFmpeg-Multistream" Foreground="#AEB6C4" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Grid.Row="2" Background="#1A1E26" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="OBS WebSocket" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Host" Margin="0,12,0,4"/>
                        <TextBox x:Name="HostTextBox" Padding="8"/>
                        <TextBlock Text="Port" Margin="0,10,0,4"/>
                        <TextBox x:Name="PortTextBox" Padding="8"/>
                        <TextBlock Text="Passwort" Margin="0,10,0,4"/>
                        <PasswordBox x:Name="ObsPasswordBox" Padding="8"/>
                        <CheckBox x:Name="VirtualCamCheckBox" Content="Virtual Camera automatisch starten" Margin="0,14,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Relay / FFmpeg" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="FFmpeg-Pfad" Margin="0,12,0,4"/>
                        <TextBox x:Name="FfmpegPathTextBox" Padding="8"/>
                        <TextBlock Text="Lokaler OBS-Relay-Eingang" Margin="0,10,0,4"/>
                        <TextBox x:Name="RelayUrlTextBox" Padding="8"/>
                        <TextBlock Margin="0,14,0,0" Foreground="#F0C36A" TextWrapping="Wrap"
                                   Text="OBS muss seinen Hauptstream an diese lokale Relay-Adresse senden. Creator Hub verteilt diesen Eingang anschließend gleichzeitig an alle aktivierten Plattformen."/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="4" Background="#1A1E26" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="Plattformen" FontSize="18" FontWeight="SemiBold"/>
                    <DataGrid x:Name="TargetsGrid" Margin="0,14,0,0" AutoGenerateColumns="False"
                              CanUserAddRows="False" HeadersVisibility="Column" Height="245"
                              Background="#11141A" Foreground="White" RowBackground="#11141A"
                              AlternatingRowBackground="#171B22" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding Enabled}" Width="70"/>
                            <DataGridTextColumn Header="Plattform" Binding="{Binding Name}" IsReadOnly="True" Width="140"/>
                            <DataGridTextColumn Header="RTMP/RTMPS-Server" Binding="{Binding ServerUrl}" Width="*"/>
                            <DataGridTextColumn Header="Stream-Key" Binding="{Binding StreamKey}" Width="280"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Grid.Row="6" Background="#1A1E26" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Live-Status und Protokoll" FontSize="18" FontWeight="SemiBold"/>
                    <ListBox x:Name="StatusList" Grid.Row="2" Background="#0E1015" Foreground="White"
                             BorderThickness="0" FontFamily="Consolas" FontSize="13"/>
                </Grid>
            </Border>

            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>
                <Button Content="OBS starten" Padding="18,12" Click="StartObsButton_Click"/>
                <Button Grid.Column="2" x:Name="ConnectButton" Content="Mit OBS verbinden" Padding="18,12" Click="ConnectButton_Click"/>
                <Button Grid.Column="4" Content="Einstellungen speichern" Padding="18,12" Click="SaveButton_Click"/>
                <Button Grid.Column="6" x:Name="LiveButton" Content="LIVE GEHEN" Padding="22,15"
                        FontSize="18" FontWeight="Bold" Background="#E53935" Foreground="White"
                        Click="LiveButton_Click"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
